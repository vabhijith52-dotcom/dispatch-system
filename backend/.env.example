# Postgres
DATABASE_URL=postgresql://dispatch_user:dispatch_pass@localhost:5432/dispatch_db
ASYNC_DATABASE_URL=postgresql://dispatch_user:dispatch_pass@localhost:5432/dispatch_db

# Auth (single login credential)
APP_USERNAME=admin
APP_PASSWORD=admin123
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE_MINUTES=720

# Video / Detection
VIDEO_SOURCE_PATH=./sample_video/test.mp4
YOLO_MODEL_PATH=./models/best.pt
CONF_THRESHOLD=0.35
CARTON_CLASS_NAME=Carton_box
TRUCK_CLASS_NAME=Truck
PLATE_CLASS_NAME=Number plate
OPEN_DOOR_CLASS_NAME=open_door

# Preprocessing output (annotated mp4 + events json cache)
OUTPUT_DIR=./output
FORCE_REPROCESS=0

# Server
BACKEND_PORT=8000
